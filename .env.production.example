# Copy this file to your deployment platform's secret/environment settings.
# Never commit real values.

# PostgreSQL
POSTGRES_DB=date_planner
POSTGRES_USER=date_planner
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=database.internal
POSTGRES_PORT=5432

# Django production identity and browser origins
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com

# HTTPS and reverse proxy
# Enable only when the trusted platform proxy overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HEADERS=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Start with a short HSTS duration, verify HTTPS, then increase deliberately.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Request limits and proxy chain
DRF_THROTTLE_ANON_RATE=60/min
DRF_THROTTLE_USER_RATE=120/min
DRF_THROTTLE_CREATE_RATE=10/min
DRF_THROTTLE_RESPONSE_RATE=20/min
DRF_THROTTLE_PLAN_RATE=20/min
DRF_NUM_PROXIES=1
DRF_THROTTLE_CACHE_LOCATION=/tmp/date-planner-throttle-cache

# Runtime
DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=2
NUXT_PUBLIC_API_BASE_URL=https://api.example.com
