# Copy this file to .env.production on the deployment server.
# Never commit the real file or paste its secrets into issues and chat logs.

# Public DNS names. Create A/AAAA records before the first launch.
APP_DOMAIN=example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL. Generate independent random passwords. The admin role is used
# only for initialization/restore; Django runs as the non-superuser app role.
# Changing these values does not rotate roles inside an existing data volume.
POSTGRES_DB=date_planner
POSTGRES_ADMIN_USER=date_planner_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
POSTGRES_APP_USER=date_planner_app
POSTGRES_APP_PASSWORD=replace-with-a-long-random-app-password

# Django. Generate a long random value; the development placeholder is rejected.
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_LOG_LEVEL=INFO

# Start with a short HSTS duration. Increase only after HTTPS is verified.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
CADDY_HSTS=max-age=3600

# Gunicorn runtime. One backend container with multiple workers is the initial target.
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30

# Docker's local logging driver rotates and compresses container logs.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Django REST Framework request limits.
DRF_THROTTLE_ANON_RATE=60/min
DRF_THROTTLE_USER_RATE=120/min
DRF_THROTTLE_CREATE_RATE=10/min
DRF_THROTTLE_RESPONSE_RATE=20/min
DRF_THROTTLE_PLAN_RATE=20/min
